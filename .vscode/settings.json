{
    "cmake.cmakePath": "/home/linuxbrew/.linuxbrew/bin/cmake",
    "cmake.environment": {
        "PATH": "/home/linuxbrew/.linuxbrew/bin:/home/linuxbrew/.linuxbrew/sbin:${env:PATH}"
    },
    "cmake.sourceDirectory": "${workspaceFolder}/cpp",
    "cmake.buildDirectory": "${workspaceFolder}/cpp/bin",
    "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
    "C_Cpp.intelliSenseEngine": "disabled",
    "clangd.arguments": [
        "--compile-commands-dir=${workspaceFolder}/cpp/bin",
        "--query-driver=/home/linuxbrew/.linuxbrew/**/g++*"
    ]
}